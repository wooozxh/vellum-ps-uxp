{
  "manifestVersion": 5,
  "id": "com.wooozxh.helloworld",
  "name": "Hello World",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.3.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "helloWorldPanel",
      "label": { "default": "Hello World" },
      "minimumSize": { "width": 230, "height": 260 },
      "maximumSize": { "width": 1600, "height": 1600 },
      "preferredDockedSize": { "width": 280, "height": 430 },
      "preferredFloatingSize": { "width": 340, "height": 450 }
    },
    {
      "type": "command",
      "id": "insertHelloWorld",
      "label": { "default": "Hello World：插入文字图层" }
    }
  ]
}
