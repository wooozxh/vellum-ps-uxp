{
  "manifestVersion": 5,
  "id": "com.wooozxh.templateprobe",
  "name": "Template Probe",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "templateProbePanel",
      "label": { "default": "Template Probe" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 1200, "height": 1200 },
      "preferredDockedSize": { "width": 340, "height": 560 },
      "preferredFloatingSize": { "width": 420, "height": 640 }
    },
    {
      "type": "command",
      "id": "templateProbeRun",
      "label": { "default": "Template Probe：运行探针" }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  }
}
