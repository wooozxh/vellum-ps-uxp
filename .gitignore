# ---------- 依赖 ----------
node_modules/

# ---------- 官方示例仓库 ----------
# 它是独立的 git 仓库（自带 .git）+ 第三方代码，不入库。
# 换机器重新拉：
#   git clone --depth 1 https://github.com/AdobeDocs/uxp-photoshop-plugin-samples.git official-samples
official-samples/

# ---------- WorkBuddy 会话数据 ----------
# AI 会话侧的本地记忆。与根目录的档案四件套定位重叠，但保持私有不入库。
.workbuddy/

# ---------- 编辑器 / 系统 ----------
.DS_Store
Thumbs.db
*.log
.eslintcache
*.tsbuildinfo

# ---------- 构建 / 打包产物 ----------
dist/
out/
*.ccx

# ---------- UXP 运行时产物 ----------
# 插件被 PS / UDT 加载时生成的会话缓存（含本机 pluginSessionId，每次加载都变），不入库。
.uxprc

# ---------- 临时 / 调试 ----------
_tmp/
_*.tmp
_*.bak

# 联动探针服务生成的测试图（可随时重生成），不入库
link-probe/sample/

# ---------- 本地行为开关 ----------
# 这两个文件存在，就会在每次加载插件时跑一遍自检 / 探针。属本地行为，不入库。
hello-world/verify.flag
hello-world/probe-text.flag
# Vellum 工具箱：verify.flag=跑无痕自检；verify-keep.flag=自检色保留到下一次加载
vellum-toolbox/verify.flag
vellum-toolbox/verify-keep.flag
# 模板探针：autorun.flag=加载即跑一遍 8 项能力探测（会建 8 个临时文档再关掉）
template-probe/autorun.flag

# ---------- 设计稿 / 测试产物 ----------
# PSD 这类二进制设计文件（含随手存的测试稿）不入库。文件仍留在本地，只是不进 git。
*.psd
*.psb
*.tif
*.tiff
Test_project/

# 插件手册的两个大产物（脚本可重建：tools/manual/make_single.py 与 Edge 无头 print-to-pdf，不入库）
docs/manual/*.pdf
docs/manual/*单文件*.html

# ---------- 设计稿的临时产物 ----------
# `preview/live/` 是 uipanel.py 每次截图覆盖的输出目录；live-now.png 是随手截的中间态。
# 其余 preview/*.png|html 是**正式设计稿**（docs 里有引用），要入库。
preview/live/
preview/live-now.png
# preview 里下划线开头的是随手截的中间态/临时图，不入库；
# 例外：_t1~_t3 是「真实缩略图副本」，设计稿 HTML 里引用了它们，要留。
preview/_*
!preview/_t1.png
!preview/_t2.png
!preview/_t3.png
