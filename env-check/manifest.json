{
  "manifestVersion": 5,
  "id": "com.wooozxh.envcheck",
  "name": "Vellum 环境体检",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "envCheckPanel",
      "label": { "default": "Vellum 环境体检" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 1600, "height": 1600 },
      "preferredDockedSize": { "width": 320, "height": 540 },
      "preferredFloatingSize": { "width": 440, "height": 640 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    },
    {
      "type": "command",
      "id": "envCheckCommand",
      "label": { "default": "Vellum 环境体检：运行并写报告" }
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["dark", "darkest", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
