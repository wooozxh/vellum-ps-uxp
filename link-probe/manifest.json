{
  "manifestVersion": 5,
  "id": "com.wooozxh.linkprobe",
  "name": "Link Probe",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.3.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "linkProbePanel",
      "label": { "default": "Link Probe" },
      "minimumSize": { "width": 230, "height": 260 },
      "maximumSize": { "width": 1400, "height": 1400 },
      "preferredDockedSize": { "width": 300, "height": 480 },
      "preferredFloatingSize": { "width": 340, "height": 520 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin",
    "network": {
      "domains": "all"
    }
  }
}
