{
  "manifestVersion": 5,
  "id": "com.vellum.toolbox",
  "name": "vellum_toolbox",
  "version": "0.2.9",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "vellumToolboxPanel",
      "label": { "default": "Vellum 工具箱" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 1600, "height": 1600 },
      "preferredDockedSize": { "width": 340, "height": 580 },
      "preferredFloatingSize": { "width": 420, "height": 680 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    },
    {
      "type": "command",
      "id": "brandPrimaryToForeground",
      "label": { "default": "Vellum 工具箱：品牌主色 → 前景色" }
    },
    {
      "type": "command",
      "id": "brandPrimaryToBackground",
      "label": { "default": "Vellum 工具箱：品牌主色 → 背景色" }
    },
    {
      "type": "command",
      "id": "brandPrimaryFill",
      "label": { "default": "Vellum 工具箱：品牌主色 → 填充当前图层/选区" },
      "shortcut": { "win": "Ctrl+Alt+F", "mac": "Cmd+Alt+F" }
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["dark", "darkest", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ],
  "requiredPermissions": {}
}
